[Unit]
Description=USSYSITE4 // The Helix Organum Node.js Backend
After=network.target

[Service]
Type=simple
User=mojo
WorkingDirectory=/home/mojo/projects/ussysite4
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3019
ExecStart=/usr/bin/node /home/mojo/projects/ussysite4/server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
